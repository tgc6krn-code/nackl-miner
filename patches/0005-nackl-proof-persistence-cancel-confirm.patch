 /// NewGoblin W7: `cancelCommitData`, delivered until `_commitData` is gone.
 /// Not bounded by the epoch: a stale commit blocks every later session.
+/// Patch 0005: `deliver()` reports a cancel done once the node ACCEPTED it, not once it ran. Wait
+/// until the chain shows `_commitData` gone (an executed cancel also rotates `_seed`), so the
+/// next read of the seed is the new one.
+pub(crate) async fn wait_cancel_executed(
+    contract: &mvsystem::miner::contract::Miner,
+    dropped: &dyn Fn() -> bool,
+) -> bool {
+    let deadline = now_ms() + CANCEL_SETTLE_MS;
+    loop {
+        if let Ok(state) = read_session_state(contract).await {
+            if state.commit_data.is_none() {
+                return true;
+            }
+        }
+        if dropped() || now_ms() >= deadline {
+            return false;
+        }
+        gloo_timers::future::TimeoutFuture::new(CHAIN_POLL_MS).await;
+    }
+}
